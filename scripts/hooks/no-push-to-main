#!/bin/sh
# pre-push hook (via pre-commit): refuse any push that updates or deletes main.
# pre-commit sets PRE_COMMIT_REMOTE_BRANCH to the remote ref being pushed.
# Work goes through a branch and a pull request; see CLAUDE.md, Git and GitHub.
if [ "$PRE_COMMIT_REMOTE_BRANCH" = "refs/heads/main" ]; then
    echo "Pushing to main is blocked. Push a branch and open a pull request instead." >&2
    exit 1
fi
exit 0
