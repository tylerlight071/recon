#!/bin/sh
# Git pre-push hook: refuse any push that updates or deletes main.
#
# GitHub Free has no rulesets for private repos, so this hook stands in for
# branch protection (CLAUDE.md, Git and GitHub). It reads git's own list of
# refs on stdin, one line per ref:
#     <local ref> <local sha> <remote ref> <remote sha>
# so multi-ref pushes, `--all`, `--mirror`, `HEAD:main` and deletions are all
# caught. Installed as .git/hooks/pre-push by scripts/install-hooks.
status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "Pushing to main is blocked (this push would update or delete it)." >&2
        echo "Push a branch and open a pull request instead." >&2
        status=1
    fi
done
exit "$status"
