# Python and tooling
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
mutants/
*.egg-info/
dist/
build/

# Test output
tests/screenshots/

# Local environment and logs (Recon's own log lives in ~/.local/share/recon)
.env
.env.*
*.log

# Never commit real data: databases, vaults, recordings
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.wav
*.flac
# ...except Recon's own generated UI sounds (scripts/make_chime.py), never recordings.
!recon/ui/sounds/*.wav

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
